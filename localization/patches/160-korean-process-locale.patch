@@ -0,0 +1,28 @@
+package com.dsharnessmobile.shell
+
+import android.app.Application
+import android.content.Context
+import android.content.res.Configuration
+import java.util.Locale
+
+/**
+ * Single-language Android product. Called for every app process, including
+ * background EngineService / OverlayService launches without MainActivity.
+ * JVM unit tests have no Application and retain upstream source-copy contracts.
+ */
+class KoreanOnlyApplication : Application() {
+  override fun attachBaseContext(base: Context) {
+    Locale.setDefault(Locale.KOREAN)
+    super.attachBaseContext(AppLanguage.wrap(base))
+  }
+
+  override fun onCreate() {
+    super.onCreate()
+    Locale.setDefault(Locale.KOREAN)
+  }
+
+  override fun onConfigurationChanged(newConfig: Configuration) {
+    super.onConfigurationChanged(newConfig)
+    Locale.setDefault(Locale.KOREAN)
+  }
+}
