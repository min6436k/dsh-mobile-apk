+package com.dsharnessmobile.shell
+
+import java.util.Locale
+
+/**
+ * Localization helper for the shell UI.
+ *
+ * Preserves the default Chinese strings when the system is set to Chinese,
+ * while providing Korean translations when the system language is Korean.
+ */
+internal object DsLocale {
+  @Volatile
+  var forceKo: Boolean? = null
+
+  @JvmStatic
+  fun isKo(): Boolean {
+    forceKo?.let { return it }
+    val lang = Locale.getDefault().language.lowercase(Locale.ROOT)
+    return lang == "ko"
+  }
+
+  @JvmStatic
+  fun tr(zh: String, ko: String): String = if (isKo()) ko else zh
+
+  private val translations: Map<String, String> = mapOf(
+    // Common / Management
+    "管理中心" to "관리 센터",
+    "DeepCode · 应用与运行时" to "DeepCode · 앱 및 런타임",
+    "DeepCode · 应用与运行环境管理" to "DeepCode · 앱 및 실행 환경 관리",
+    "打开控制台" to "콘솔 열기",
+    "终端与运行日志" to "터미널 및 실행 로그",
+    "查看终端与运行日志" to "터미널 및 실행 로그 확인",
+    "插件管理" to "플러그인 관리",
+    "启停与配置" to "플러그인 켜기/끄기 및 설정 편집",
+    "启停插件与编辑配置" to "플러그인 켜기/끄기 및 설정 편집",
+    "存储管理" to "저장소 관리",
+    "数据、容量与导出" to "데이터, 용량 및 내보내기",
+    "私有数据、容量与公共导出目录" to "비공개 데이터, 용량 및 공용 내보내기 디렉터리",
+    "界面语言" to "화면 언어",
+    "切换" to "변경",
+    "跟随系统" to "시스템 설정 따름",
+    "中文" to "중국어",
+    "打开管理中心" to "관리 센터 열기",
+    "关闭管理中心" to "관리 센터 닫기",
+    "返回管理中心" to "관리 센터로 돌아가기",
+    "公共导出目录" to "공용 내보내기 디렉터리",
+    "应用私有数据" to "앱 비공개 데이터",
+    "应用私有运行时" to "앱 비공개 런타임",
