+  @JvmStatic
+  fun lookup(zh: String, fallback: String): String {
+    return translations[zh] ?: run {
+      for ((key, value) in translations) {
+        if (zh.startsWith(key) && key.length > 3) {
+          return value + zh.substring(key.length)
+        }
+      }
+      fallback
+    }
+  }
