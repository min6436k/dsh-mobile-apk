+      assertTrue(controller.contains("R.drawable.ds_theme_$icon"))
+      val vector = File(root, "res/drawable/ds_theme_$icon.xml")
+      assertTrue("missing vector for $icon", vector.exists())
+      assertTrue(vector.readText().contains("<vector"))
+    }
+    assertFalse("theme icons must not depend on font-specific emoji", controller.contains("☀"))
+    assertFalse(controller.contains("☾"))
+    assertFalse(controller.contains("⚙"))
+    assertTrue("vector and label colors must animate together", controller.contains("vector?.setTint"))
+    assertTrue("outer corners stay rounded independently", controller.contains("if (index == 0) outer else middle"))
+    assertTrue(File(root, "assets/licenses/lucide-theme-icons.txt").exists())
+  }
