+  @Test fun threeConnectedThemeOptionsUseTintableVectorArtInsteadOfEmoji() {
+    val root = listOf(File("src/main"), File("app/src/main")).first { it.exists() }
+    val controller = File(root, "java/com/dsharnessmobile/shell/GuideManagementController.kt").readText()
