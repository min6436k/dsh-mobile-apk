@@ -0,0 +1,56 @@
+package com.dsharnessmobile.shell
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Fork-only release trust, checksum, and exact-build version identity. */
+class KoSecurityHardeningTest {
+  private val tag = "ko-v0.14.8-u7cd7ccab8247-p123456789abc"
+  private val apk = "https://github.com/min6436k/dsh-mobile-apk-Ko-KR-Patch/releases/download/$tag/dsh-ko-arm64.apk"
+
+  private fun body(withHash: Boolean = true): String {
+    val assets = JSONArray().put(
+      JSONObject().put("name", "dsh-ko-arm64.apk").put("browser_download_url", apk).put("size", 16),
+    )
+    if (withHash) {
+      assets.put(JSONObject().put("name", "dsh-ko-arm64.apk.sha256")
+        .put("browser_download_url", "$apk.sha256").put("size", 80))
+    }
+    return JSONObject().put("tag_name", tag).put("assets", assets).toString()
+  }
+
+  @Test fun onlyThisForkCanSupplyUpdates() {
+    assertTrue(UpdateChecker.isTrustedAssetUrl(apk, tag))
+    assertFalse(UpdateChecker.isTrustedAssetUrl(apk.replace("github.com/", "gh-proxy.com/"), tag))
+    assertFalse(UpdateChecker.isTrustedAssetUrl(apk.replace("github.com/", "attacker.example/"), tag))
+    assertFalse(UpdateChecker.isTrustedAssetUrl(apk.replace("https:", "http:"), tag))
+    assertFalse(UpdateChecker.isTrustedAssetUrl(apk.replace("dsh-ko-arm64.apk", "dsh-ko-arm64.apk?token=x"), tag))
+  }
+
+  @Test fun missingChecksumRefusesUpgrade() {
+    val verdict = UpdateChecker.classifyLatestBody(
+      body(withHash = false), listOf("arm64-v8a"), "arm64", "ko-v0.14.8-uold-pold",
+    )
+    assertTrue(verdict is UpdateChecker.CheckResult.Failed)
+    assertEquals(UpdateChecker.CheckResult.FailureKind.RELEASE_DATA_BROKEN,
+      (verdict as UpdateChecker.CheckResult.Failed).kind)
+  }
+
+  @Test fun patchBuildIdentityPreventsRepeatedSameVersionUpdate() {
+    assertEquals(UpdateChecker.CheckResult.UpToDate,
+      UpdateChecker.classifyLatestBody(body(), listOf("arm64-v8a"), "arm64", tag))
+    val verdict = UpdateChecker.classifyLatestBody(body(), listOf("arm64-v8a"), "arm64",
+      "ko-v0.14.8-u7cd7ccab8247-p000000000000")
+    assertTrue(verdict is UpdateChecker.CheckResult.Available)
+    assertEquals("$apk.sha256", (verdict as UpdateChecker.CheckResult.Available).sha256Url)
+  }
+
+  @Test fun unsupportedAbiNeverDownloadsArm64() {
+    assertTrue(UpdateChecker.assetNameCandidates(tag, "x86_64").isEmpty())
+    assertEquals(listOf("dsh-ko-arm64.apk"), UpdateChecker.assetNameCandidates(tag, "arm64"))
+  }
+}
