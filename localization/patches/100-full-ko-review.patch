+function isKo(): boolean {
+  try {
+    const lang = typeof navigator !== 'undefined' ? (navigator.language || '') : (process.env.LANG || process.env.LC_ALL || '')
+    return /^ko\b/i.test(lang)
+  } catch {
+    return false
+  }
+}
+
+function ko(zh: string, koText: string): string {
+  return isKo() ? koText : zh
+}
