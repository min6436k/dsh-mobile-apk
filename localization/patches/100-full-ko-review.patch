+test('Korean locale creates a Korean display title while keeping the workspace path as identity', async () => {
+  const prev = process.env.DSH_MOBILE_LOCALE
+  const home = mkdtempSync(join(tmpdir(), 'dsh-ko-title-'))
+  try {
+    process.env.DSH_MOBILE_LOCALE = 'ko'
+    process.env.DSH_HOME = home
+    const harness = makeCtx()
+    await boot(harness.ctx)
+    assert.equal(harness.workspaces.length, 1)
+    assert.equal(harness.workspaces[0].title, '임시 작업 공간')
+    assert.equal(harness.workspaces[0].path, realpathSync(join(home, 'workspaces', 'incoming')))
+  } finally {
+    if (prev === undefined) delete process.env.DSH_MOBILE_LOCALE
+    else process.env.DSH_MOBILE_LOCALE = prev
+    process.env.DSH_HOME = mkdtempSync(join(tmpdir(), 'dsh-file-open-'))
+  }
+})
+
+test('Korean locale reuses a canonical workspace with an old Chinese title and preserves its session ID', async () => {
+  const prev = process.env.DSH_MOBILE_LOCALE
+  const home = mkdtempSync(join(tmpdir(), 'dsh-ko-legacy-'))
+  try {
+    process.env.DSH_MOBILE_LOCALE = 'ko'
+    process.env.DSH_HOME = home
+    const canonical = join(home, 'workspaces', 'incoming')
+    mkdirSync(canonical, { recursive: true })
+    const workspaces = [{ id: 'ws-legacy', path: canonical, title: '临时工作区', sessionIds: ['session-aaaaaaaa-1'] }]
+    const harness = makeCtx(undefined, { workspaces })
+    await boot(harness.ctx)
+    assert.equal(harness.workspaces[0].id, 'ws-legacy')
+    assert.deepEqual(harness.workspaces[0].sessionIds, ['session-aaaaaaaa-1'])
+    assert.equal(harness.calls.workspaceCreate.length, 0)
+  } finally {
+    if (prev === undefined) delete process.env.DSH_MOBILE_LOCALE
+    else process.env.DSH_MOBILE_LOCALE = prev
+    process.env.DSH_HOME = mkdtempSync(join(tmpdir(), 'dsh-file-open-'))
+  }
+})
+
