+/** Pick Chinese, English, or Korean copy for the active locale. */
+export function tr(zh: string, en: string, ko?: string): string {
+  if (isKorean()) return ko ?? KO_MAP[zh] ?? en
   return isEnglish() ? en : zh
 }
 
 /**
  * Candidate labels for an upstream control we match by text.
  *
- * Upstream localizes its own copy, so a claimed action must accept both
+ * Upstream localizes its own copy, so a claimed action must accept all
  * languages regardless of the active one.
  */
-export function both(zh: string, en: string): string[] {
-  return [zh, en]
+export function both(zh: string, en: string, ko?: string): string[] {
+  const result = [zh, en]
+  const k = ko ?? KO_MAP[zh]
+  if (k && !result.includes(k)) result.push(k)
+  return result
 }
