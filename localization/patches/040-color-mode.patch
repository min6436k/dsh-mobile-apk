+            chips.forEachIndexed { position, (view, drawable) ->
+              val choice = choices[position].first
+              val startFill = if (choice == fromMode) selectedFill else plainFill
+              val endFill = if (choice == mode) selectedFill else plainFill
+              val startInk = if (choice == fromMode) selectedInk else plainInk
+              val endInk = if (choice == mode) selectedInk else plainInk
+              drawable.setColor(ArgbEvaluator.getInstance().evaluate(fraction, startFill, endFill) as Int)
+              view.setTextColor(ArgbEvaluator.getInstance().evaluate(fraction, startInk, endInk) as Int)
+            }
+          }
