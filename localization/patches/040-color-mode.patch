+    var switching = false
+    choices.forEachIndexed { index, (mode, title) ->
+      // Android's corner array is ordered TL, TR, BR, BL (x/y for each corner).
+      val left = if (index == 0) outer else middle
+      val right = if (index == choices.lastIndex) outer else middle
+      val shape = GradientDrawable().apply {
+        cornerRadii = floatArrayOf(left, left, right, right, right, right, left, left)
+        setColor(if (selected == mode) selectedFill else plainFill)
+      }
+      val chip = TextView(activity).apply {
+        text = title
+        gravity = Gravity.CENTER
+        textSize = 13f
+        setSingleLine(true)
+        setTextColor(if (selected == mode) selectedInk else plainInk)
+        background = android.graphics.drawable.RippleDrawable(
+          android.content.res.ColorStateList.valueOf(activity.getColor(R.color.ds_accent_soft)),
+          shape,
