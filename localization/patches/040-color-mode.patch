diff --git a/app/src/test/java/com/dsharnessmobile/shell/AppThemeTest.kt b/app/src/test/java/com/dsharnessmobile/shell/AppThemeTest.kt
new file mode 100644
index 0000000..2e656a2
--- /dev/null
+++ b/app/src/test/java/com/dsharnessmobile/shell/AppThemeTest.kt
@@ -0,0 +1,20 @@
+package com.dsharnessmobile.shell
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class AppThemeTest {
+  @Test fun normalizesInvalidAndMissingModes() {
+    assertEquals(AppTheme.MODE_SYSTEM, AppTheme.normalize(null))
+    assertEquals(AppTheme.MODE_SYSTEM, AppTheme.normalize("unexpected"))
+    assertEquals(AppTheme.MODE_DARK, AppTheme.normalize(AppTheme.MODE_DARK))
+    assertEquals(AppTheme.MODE_LIGHT, AppTheme.normalize(AppTheme.MODE_LIGHT))
+  }
+
+  @Test fun selectedModeOverridesDeviceNightSetting() {
+    assertEquals(false, AppTheme.resolveDark(AppTheme.MODE_LIGHT, true))
+    assertEquals(true, AppTheme.resolveDark(AppTheme.MODE_DARK, false))
+    assertEquals(true, AppTheme.resolveDark(AppTheme.MODE_SYSTEM, true))
+    assertEquals(false, AppTheme.resolveDark(AppTheme.MODE_SYSTEM, false))
+  }
+}
