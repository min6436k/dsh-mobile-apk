+    )
+    val strip = LinearLayout(activity).apply { orientation = LinearLayout.HORIZONTAL }
+    val chips = mutableListOf<Pair<TextView, GradientDrawable>>()
+    val selectedFill = activity.getColor(R.color.ds_accent)
+    val selectedInk = activity.getColor(R.color.ds_text_on_accent)
