+      chip.setOnClickListener {
+        if (switching || selected == mode) return@setOnClickListener
+        switching = true
+        val fromMode = selected
+        selected = mode
+        chips.forEachIndexed { position, (view, _) -> view.isSelected = choices[position].first == mode }
+        val transition = ValueAnimator.ofFloat(0f, 1f).apply {
+          duration = 200
+          interpolator = DsUi.ease
+          addUpdateListener { frame ->
