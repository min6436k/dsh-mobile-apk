+package com.dsharnessmobile.shell
+
+import android.content.Context
+import android.content.res.Configuration
+
+/** Native and embedded-WebView color mode: follow the device, light, or dark. */
+internal object AppTheme {
+  private const val PREFS = "dsh_settings"
+  private const val KEY_MODE = "theme_mode"
+
+  const val MODE_LIGHT = "light"
+  const val MODE_DARK = "dark"
+  const val MODE_SYSTEM = "system"
+
+  internal fun normalize(value: String?): String = when (value) {
+    MODE_LIGHT, MODE_DARK -> value
+    else -> MODE_SYSTEM
+  }
+
+  fun mode(context: Context): String = try {
+    normalize(context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(KEY_MODE, MODE_SYSTEM))
+  } catch (_: Exception) {
+    MODE_SYSTEM
+  }
+
+  fun setMode(context: Context, value: String) {
+    context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+      .edit().putString(KEY_MODE, normalize(value)).apply()
+  }
+
+  internal fun resolveDark(value: String, systemDark: Boolean): Boolean = when (normalize(value)) {
+    MODE_LIGHT -> false
+    MODE_DARK -> true
+    else -> systemDark
+  }
+
+  /** Application resources are not wrapped, so they retain the actual device preference. */
+  fun isDark(context: Context): Boolean {
+    val systemNight = (context.applicationContext.resources.configuration.uiMode and
+      Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES
+    return resolveDark(mode(context), systemNight)
+  }
+
+  fun wrap(base: Context): Context {
+    val selected = mode(base)
+    if (selected == MODE_SYSTEM) return base
+    val configuration = Configuration(base.resources.configuration)
+    configuration.uiMode = (configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK.inv()) or
+      (if (selected == MODE_DARK) Configuration.UI_MODE_NIGHT_YES else Configuration.UI_MODE_NIGHT_NO)
+    return try {
+      base.createConfigurationContext(configuration)
+    } catch (_: Exception) {
+      base
+    }
+  }
+}
