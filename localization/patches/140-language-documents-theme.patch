diff --git a/app/src/main/java/com/dsharnessmobile/shell/AppDocumentsPath.kt b/app/src/main/java/com/dsharnessmobile/shell/AppDocumentsPath.kt
new file mode 100644
index 0000000..980cd40
--- /dev/null
+++ b/app/src/main/java/com/dsharnessmobile/shell/AppDocumentsPath.kt
@@ -0,0 +1,47 @@
+package com.dsharnessmobile.shell
+
+import java.io.File
+import java.io.FileNotFoundException
+
+/** File IDs are relative to the app's filesDir, never absolute user-supplied paths. */
+internal object AppDocumentsPath {
+  const val ROOT_ID = "files:"
+
+  @Throws(FileNotFoundException::class)
+  fun resolve(root: File, id: String): File {
+    if (id == ROOT_ID) return root.canonicalFile
+    if (!id.startsWith(ROOT_ID) || id.length == ROOT_ID.length) throw FileNotFoundException("Invalid document ID")
+    val relative = id.substring(ROOT_ID.length)
+    if (relative.startsWith('/') || relative.startsWith('\\') || relative.split('/').any {
+        it == ".." || it == "." || it.isEmpty() || it.contains('\\') || it.contains('\u0000')
+      }) throw FileNotFoundException("Invalid document path")
+    val base = root.canonicalFile
+    val file = File(base, relative).canonicalFile
+    if (!within(base, file)) throw FileNotFoundException("Document escapes app files directory")
+    return file
+  }
+
+  @Throws(FileNotFoundException::class)
+  fun idFor(root: File, file: File): String {
+    val base = root.canonicalFile
+    val canonical = file.canonicalFile
+    if (!within(base, canonical)) throw FileNotFoundException("Document escapes app files directory")
+    return if (base == canonical) ROOT_ID else ROOT_ID + canonical.relativeTo(base).invariantSeparatorsPath
+  }
+
+  fun isChild(root: File, parent: String, child: String): Boolean = try {
+    val base = root.canonicalFile
+    val p = resolve(base, parent)
+    val c = resolve(base, child)
+    c != p && within(p, c)
+  } catch (_: Exception) {
+    false
+  }
+
+  private fun within(base: File, file: File): Boolean =
+    file == base || file.path.startsWith(base.path + File.separator)
+
+  fun validName(name: String): Boolean =
+    name.isNotBlank() && name != "." && name != ".." &&
+      '/' !in name && '\\' !in name && '\u0000' !in name
+}
diff --git a/app/src/main/java/com/dsharnessmobile/shell/AppFilesDocumentsProvider.kt b/app/src/main/java/com/dsharnessmobile/shell/AppFilesDocumentsProvider.kt
new file mode 100644
index 0000000..5f1a089
--- /dev/null
+++ b/app/src/main/java/com/dsharnessmobile/shell/AppFilesDocumentsProvider.kt
@@ -0,0 +1,131 @@
+package com.dsharnessmobile.shell
+
+import android.database.Cursor
+import android.database.MatrixCursor
+import android.os.CancellationSignal
+import android.os.ParcelFileDescriptor
+import android.provider.DocumentsContract.Document
+import android.provider.DocumentsContract.Root
+import android.provider.DocumentsProvider
+import android.webkit.MimeTypeMap
+import java.io.File
+import java.io.FileNotFoundException
+import java.util.Locale
+
+/**
+ * Android Storage Access Framework view of this app's filesDir.
+ *
+ * Android's BIND_DOCUMENTS_PROVIDER gate and per-document SAF grants protect
+ * the exported provider. Never grant a broad ContentProvider read permission.
+ * This intentionally excludes app databases, cache and SharedPreferences.
+ */
+class AppFilesDocumentsProvider : DocumentsProvider() {
+  private val filesRoot: File get() = requireNotNull(context).filesDir.canonicalFile
+
+  override fun onCreate(): Boolean = true
+
+  override fun queryRoots(projection: Array<out String>?): Cursor {
+    val cursor = MatrixCursor(projection ?: ROOT_COLUMNS)
+    val root = filesRoot
+    val row = cursor.newRow()
+    row.add(Root.COLUMN_ROOT_ID, "app-files")
+    row.add(Root.COLUMN_DOCUMENT_ID, AppDocumentsPath.ROOT_ID)
+    row.add(Root.COLUMN_TITLE, requireNotNull(context).getString(R.string.documents_root_label))
+    row.add(Root.COLUMN_SUMMARY, requireNotNull(context).getString(R.string.documents_root_summary))
+    row.add(Root.COLUMN_FLAGS, Root.FLAG_LOCAL_ONLY or Root.FLAG_SUPPORTS_CREATE or Root.FLAG_SUPPORTS_IS_CHILD)
+    row.add(Root.COLUMN_ICON, R.mipmap.ic_launcher)
+    row.add(Root.COLUMN_AVAILABLE_BYTES, root.usableSpace)
+    row.add(Root.COLUMN_MIME_TYPES, "*/*")
+    return cursor
+  }
+
+  override fun queryDocument(documentId: String, projection: Array<out String>?): Cursor {
+    val file = existing(documentId)
+    return MatrixCursor(projection ?: DOC_COLUMNS).apply { addFile(this, file) }
+  }
+
+  override fun queryChildDocuments(parentDocumentId: String, projection: Array<out String>?, sortOrder: String?): Cursor {
+    val folder = existing(parentDocumentId)
+    if (!folder.isDirectory) throw FileNotFoundException("Not a directory")
+    return MatrixCursor(projection ?: DOC_COLUMNS).apply {
+      folder.listFiles()?.sortedBy { it.name.lowercase(Locale.ROOT) }?.forEach { file ->
+        // Reject symlinks resolving outside filesDir, even if they exist under usr/home.
+        try { addFile(this, file) } catch (_: FileNotFoundException) { /* unsafe entry hidden */ }
+      }
+    }
+  }
+
+  override fun openDocument(documentId: String, mode: String, signal: CancellationSignal?): ParcelFileDescriptor {
+    signal?.throwIfCanceled()
+    val file = existing(documentId)
+    if (file.isDirectory) throw FileNotFoundException("Cannot open a directory as a file")
+    return ParcelFileDescriptor.open(file, ParcelFileDescriptor.parseMode(mode))
+  }
+
+  override fun createDocument(parentDocumentId: String, mimeType: String, displayName: String): String {
+    if (!AppDocumentsPath.validName(displayName)) throw FileNotFoundException("Invalid filename")
+    val parent = existing(parentDocumentId)
+    if (!parent.isDirectory || !parent.canWrite()) throw FileNotFoundException("Folder is not writable")
+    val child = File(parent, displayName)
+    if (child.exists()) throw FileNotFoundException("File already exists")
+    AppDocumentsPath.idFor(filesRoot, child)
+    val created = if (mimeType == Document.MIME_TYPE_DIR) child.mkdir() else child.createNewFile()
+    if (!created) throw FileNotFoundException("Failed to create document")
+    return AppDocumentsPath.idFor(filesRoot, child)
+  }
+
+  override fun deleteDocument(documentId: String) {
+    val file = mutableFile(documentId)
+    // Directory deletion is intentionally non-recursive: never erase a whole runtime tree.
+    if (!file.delete()) throw FileNotFoundException("Failed to delete document or directory is not empty")
+  }
+
+  override fun renameDocument(documentId: String, displayName: String): String {
+    if (!AppDocumentsPath.validName(displayName)) throw FileNotFoundException("Invalid filename")
+    val file = mutableFile(documentId)
+    val dest = File(file.parentFile, displayName)
+    AppDocumentsPath.idFor(filesRoot, dest)
+    if (dest.exists() || !file.renameTo(dest)) throw FileNotFoundException("Rename failed")
+    return AppDocumentsPath.idFor(filesRoot, dest)
+  }
+
+  override fun isChildDocument(parentDocumentId: String, documentId: String): Boolean =
+    AppDocumentsPath.isChild(filesRoot, parentDocumentId, documentId)
+
+  private fun mutableFile(id: String): File {
+    if (id == AppDocumentsPath.ROOT_ID) throw FileNotFoundException("Cannot modify root")
+    return existing(id)
+  }
+
+  private fun existing(id: String): File = AppDocumentsPath.resolve(filesRoot, id).also {
+    if (!it.exists()) throw FileNotFoundException("Document not found")
+  }
+
+  private fun addFile(cursor: MatrixCursor, file: File) {
+    val id = AppDocumentsPath.idFor(filesRoot, file)
+    val directory = file.isDirectory
+    val mime = if (directory) Document.MIME_TYPE_DIR else {
+      val ext = file.extension.lowercase(Locale.ROOT)
+      MimeTypeMap.getSingleton().getMimeTypeFromExtension(ext) ?: "application/octet-stream"
+    }
+    val flags = if (file.canWrite()) {
+      (if (directory) Document.FLAG_DIR_SUPPORTS_CREATE else Document.FLAG_SUPPORTS_WRITE) or
+        (if (id != AppDocumentsPath.ROOT_ID) Document.FLAG_SUPPORTS_DELETE or Document.FLAG_SUPPORTS_RENAME else 0)
+    } else 0
+    cursor.newRow().apply {
+      add(Document.COLUMN_DOCUMENT_ID, id)
+      add(Document.COLUMN_DISPLAY_NAME, if (id == AppDocumentsPath.ROOT_ID) filesRoot.name else file.name)
+      add(Document.COLUMN_MIME_TYPE, mime)
+      add(Document.COLUMN_FLAGS, flags)
+      add(Document.COLUMN_SIZE, if (directory) 0L else file.length())
+      add(Document.COLUMN_LAST_MODIFIED, file.lastModified())
+    }
+  }
+
+  private companion object {
+    val ROOT_COLUMNS = arrayOf(Root.COLUMN_ROOT_ID, Root.COLUMN_DOCUMENT_ID, Root.COLUMN_TITLE,
+      Root.COLUMN_SUMMARY, Root.COLUMN_FLAGS, Root.COLUMN_ICON, Root.COLUMN_AVAILABLE_BYTES, Root.COLUMN_MIME_TYPES)
+    val DOC_COLUMNS = arrayOf(Document.COLUMN_DOCUMENT_ID, Document.COLUMN_DISPLAY_NAME,
+      Document.COLUMN_MIME_TYPE, Document.COLUMN_FLAGS, Document.COLUMN_SIZE, Document.COLUMN_LAST_MODIFIED)
+  }
+}
