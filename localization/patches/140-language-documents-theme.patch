diff --git a/app/src/test/java/com/dsharnessmobile/shell/AppDocumentsPathTest.kt b/app/src/test/java/com/dsharnessmobile/shell/AppDocumentsPathTest.kt
new file mode 100644
index 0000000..da733a7
--- /dev/null
+++ b/app/src/test/java/com/dsharnessmobile/shell/AppDocumentsPathTest.kt
@@ -0,0 +1,69 @@
+package com.dsharnessmobile.shell
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Test
+import java.io.File
+import java.io.FileNotFoundException
+import java.nio.file.Files
+
+class AppDocumentsPathTest {
+  private inline fun rejects(block: () -> Unit) {
+    try { block(); fail("Expected path to be rejected") }
+    catch (_: FileNotFoundException) { /* denied */ }
+  }
+
+  @Test fun internalFilesAreAddressedByStableRelativeIds() {
+    val root = Files.createTempDirectory("dsh-docs").toFile()
+    try {
+      val child = File(root, "home/workspace/notes.txt")
+      child.parentFile.mkdirs()
+      child.writeText("hello")
+      assertEquals("files:", AppDocumentsPath.idFor(root, root))
+      assertEquals("files:home/workspace/notes.txt", AppDocumentsPath.idFor(root, child))
+      assertEquals(child.canonicalFile, AppDocumentsPath.resolve(root, "files:home/workspace/notes.txt"))
+      assertTrue(AppDocumentsPath.isChild(root, "files:home", "files:home/workspace/notes.txt"))
+      assertFalse(AppDocumentsPath.isChild(root, "files:home/workspace", "files:home"))
+      assertFalse(AppDocumentsPath.isChild(root, "files:home", "files:home"))
+    } finally { root.deleteRecursively() }
+  }
+
+  @Test fun traversalAbsolutePathsAndMalformedNamesAreDenied() {
+    val root = Files.createTempDirectory("dsh-docs").toFile()
+    try {
+      listOf("", "home", "files:../outside", "files:/etc/passwd", "files:home/../other", "files:home//other",
+        "files:./file", "files:home\\name", "files:home/./doc").forEach { id -> rejects { AppDocumentsPath.resolve(root, id) } }
+      assertFalse(AppDocumentsPath.validName("../secret"))
+      assertFalse(AppDocumentsPath.validName(".."))
+      assertFalse(AppDocumentsPath.validName("a/b"))
+      assertFalse(AppDocumentsPath.validName(""))
+      assertTrue(AppDocumentsPath.validName("메모.txt"))
+    } finally { root.deleteRecursively() }
+  }
+
+  @Test fun symlinksCannotReachOutsideTheAppDirectory() {
+    val root = Files.createTempDirectory("dsh-docs-root").toFile()
+    val outside = Files.createTempDirectory("dsh-docs-outside").toFile()
+    try {
+      val link = File(root, "outside")
+      Files.createSymbolicLink(link.toPath(), outside.toPath())
+      rejects { AppDocumentsPath.resolve(root, "files:outside/private.txt") }
+      rejects { AppDocumentsPath.idFor(root, File(outside, "private.txt")) }
+      assertFalse(AppDocumentsPath.isChild(root, "files:", "files:outside/private.txt"))
+    } finally { root.deleteRecursively(); outside.deleteRecursively() }
+  }
+
+  @Test fun providerRequiresSystemSafGrantsAndNeverExportsFullDataDirectory() {
+    val src = listOf(File("src/main"), File("app/src/main")).first { it.isDirectory }
+    val xml = File(src, "AndroidManifest.xml").readText()
+    val klass = File(src, "java/com/dsharnessmobile/shell/AppFilesDocumentsProvider.kt").readText()
+    assertTrue(xml.contains("android:name=".AppFilesDocumentsProvider""))
+    assertTrue(xml.contains("android:permission="android.permission.MANAGE_DOCUMENTS""))
+    assertTrue(xml.contains("android:grantUriPermissions="true""))
+    assertTrue(klass.contains("context).filesDir.canonicalFile"))
+    assertTrue(klass.contains("AppDocumentsPath.idFor(filesRoot, file)"))
+    assertTrue(klass.contains("if (id == AppDocumentsPath.ROOT_ID) throw"))
+  }
+}
