diff --git a/app/src/test/java/com/dsharnessmobile/shell/PackageVisibilityTest.kt b/app/src/test/java/com/dsharnessmobile/shell/PackageVisibilityTest.kt
new file mode 100644
index 0000000..60c522c
--- /dev/null
+++ b/app/src/test/java/com/dsharnessmobile/shell/PackageVisibilityTest.kt
@@ -0,0 +1,37 @@
+package com.dsharnessmobile.shell
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/** Keep Android 11+ package queries sufficient without enumerating every app. */
+class PackageVisibilityTest {
+  private val main: File get() = listOf(File("src/main"), File("app/src/main")).first { it.isDirectory }
+
+  @Test fun broadPackageEnumerationPermissionIsNotRequested() {
+    val xml = File(main, "AndroidManifest.xml").readText()
+    assertFalse(xml.contains("<uses-permission android:name=\"android.permission.QUERY_ALL_PACKAGES\""))
+    assertTrue(xml.contains("<queries>"))
+    assertTrue(xml.contains("<action android:name=\"android.intent.action.OPEN_DOCUMENT_TREE\""))
+    assertTrue(xml.contains("<data android:mimeType=\"*/*\""))
+    assertTrue(xml.contains("<data android:scheme=\"https\""))
+  }
+
+  @Test fun everyKnownRootManagerAndFileManagerRemainsQueryable() {
+    val xml = File(main, "AndroidManifest.xml").readText()
+    val sourceDir = File(main, "java/com/dsharnessmobile/shell")
+    val consumers = listOf("RootAccess.kt", "ExternalLinks.kt", "PathOpen.kt")
+      .joinToString("\n") { File(sourceDir, it).readText() }
+    val packages = listOf(
+      "me.weishu.kernelsu", "com.topjohnwu.magisk", "me.bmax.apatch",
+      "moe.shizuku.privileged.api", "roro.stellar.manager",
+      "bin.mt.plus", "com.android.documentsui", "com.google.android.documentsui",
+    )
+    for (name in packages) {
+      assertTrue("Missing package consumer for $name", consumers.contains(name))
+      assertTrue("Missing scoped manifest query for $name",
+        xml.contains("<package android:name=\"$name\""))
+    }
+  }
+}
